# social-publisher-mcp — publikacja postów na LinkedIn, Facebook i Instagram
# Autor: LuMiGRAF Technology Lab — https://dev.lm-ads.com
# Kontakt: l@lm-networks.pl
# © 2026 LuMiGRAF Technology Lab

# Skopiuj do .env i uzupełnij. Platformy bez tokenów są po prostu pomijane.

# true = wszystkie narzędzia domyślnie działają w trybie podglądu (nic nie publikują)
SOCIAL_MCP_DRY_RUN=false

# ---------- LinkedIn ----------
# Dane aplikacji (tylko dla `npm run auth:linkedin`)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Dla stron firmowych dodaj w_organization_social (wymaga Community Management API)
# LINKEDIN_SCOPES=openid profile w_member_social
LINKEDIN_ACCESS_TOKEN=
# urn:li:person:XXXX (profil) lub urn:li:organization:12345 (strona firmy)
LINKEDIN_AUTHOR_URN=
# Wersja API w formacie YYYYMM; puste = automatyczny wybór najnowszej aktywnej
LINKEDIN_API_VERSION=
# true = link w pierwszym komentarzu (wymaga Community Management API); inaczej link idzie do tresci posta
LINKEDIN_COMMENTS=false

# ---------- Meta (Facebook + Instagram) ----------
# Dane aplikacji (tylko dla `npm run auth:meta`)
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v24.0

FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=

# ID konta Instagram Business/Creator połączonego ze stroną
INSTAGRAM_USER_ID=
# Puste = używany jest FACEBOOK_PAGE_ACCESS_TOKEN
INSTAGRAM_ACCESS_TOKEN=
# graph.facebook.com (logowanie przez Facebooka) lub graph.instagram.com (Instagram Login)
INSTAGRAM_API_HOST=graph.facebook.com

# ---------- Serwer HTTP (--http) ----------
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=3100
# Wymagany, gdy serwer nasłuchuje poza localhost
MCP_AUTH_TOKEN=
# Publiczny adres serwera; włącza /media/ dla Instagrama
SOCIAL_MCP_PUBLIC_URL=
# SOCIAL_MCP_MEDIA_DIR=media
# Co ile minut wysyłać kolejkę (0 = wyłączone)
SOCIAL_MCP_QUEUE_INTERVAL_MIN=5

# ---------- Powiadomienia Telegram (po publikacji z kolejki) ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Topik w grupie z tematami (opcjonalnie)
TELEGRAM_THREAD_ID=
